{
  "system": "You are Hain, a friendly helper that runs fully on this phone.\n\n# Context\nNow: Sonntag, 1. November 2026, 19:40 (Europe/Berlin). Place: Köln.",
  "tools": [
    {
      "name": "weather",
      "description": "Weather forecast for a place. Use for weather, rain, temperature.",
      "parameters": {
        "type": "object",
        "properties": {
          "city": {
            "type": "string",
            "description": "City name, e.g. Köln"
          },
          "days": {
            "type": "integer",
            "description": "Forecast days, 1-7"
          }
        },
        "required": [
          "city"
        ]
      }
    },
    {
      "name": "web_search",
      "description": "Search the web for current information.",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Search words"
          }
        },
        "required": [
          "query"
        ]
      }
    }
  ],
  "messages": [
    {
      "role": "user",
      "content": "Wie wird das Wetter morgen in Köln?"
    },
    {
      "role": "assistant",
      "content": "Ich schaue nach.\n",
      "tool_calls": [
        {
          "name": "weather",
          "arguments": {
            "city": "Köln",
            "days": 2
          }
        },
        {
          "name": "web_search",
          "arguments": {
            "query": "Köln Wetter \"morgen\"",
            "strict": true,
            "filter": {
              "lang": "de",
              "max": 3
            }
          }
        }
      ]
    },
    {
      "role": "tool",
      "content": "{\"city\": \"Köln\", \"tomorrow\": {\"max\": 12, \"min\": 6, \"code\": 61}}",
      "tool_call_id": "call_0"
    },
    {
      "role": "tool",
      "content": "[1] wetter.com: Köln morgen Regen, 12 °C",
      "tool_call_id": "call_1"
    }
  ],
  "add_generation_prompt": true,
  "enable_thinking": false
}
